        "scope": "登録した患者の表示",
        "method": "browser_text",
        "target": "patient-banner",
        "expect": "contains",
        "text": "{{test_value}}"
      },
      {
        "id": "patient-http",
        "scope": "患者登録のHTTP応答",
        "method": "browser_response",
        "target": "patient-save",
