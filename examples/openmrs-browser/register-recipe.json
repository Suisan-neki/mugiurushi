      {
        "id": "username",
        "action": "fill",
        "target": {
          "frames": [],
          "locator": {
            "by": "css",
            "selector": "#username"
          }
        },
        "value": {
          "source": "secret",
          "key": "username"
        }
      },
      {
        "id": "continue",
        "action": "click",
        "target": {
          "frames": [],
          "locator": {
            "by": "css",
            "selector": "button[type=submit]"
          }
        }
      },
      {
        "id": "password",
        "action": "fill",
        "target": {
          "frames": [],
          "locator": {
            "by": "css",
            "selector": "#password"
          }
        },
        "value": {
          "source": "secret",
          "key": "password"
        }
      },
      {
        "id": "login",
        "action": "click",
        "target": {
          "frames": [],
          "locator": {
            "by": "css",
            "selector": "button[type=submit]"
          }
        }
      },
      {
        "id": "location",
        "action": "click",
        "target": {
          "frames": [],
          "locator": {
            "by": "css",
            "selector": "label:has-text(\"Outpatient Clinic\")"
          }
        }
      },
      {
        "id": "confirm-location",
        "action": "click",
        "target": {
          "frames": [],
          "locator": {
            "by": "css",
            "selector": "button[type=submit]"
          }
        }
      },
      {
        "id": "home",
        "action": "read_text",
        "target": {
          "frames": [],
          "locator": {
            "by": "css",
            "selector": "button[aria-label=\"Add patient\"]"
          }
        },
        "contains": null
      }
    ],
    "actions": [
      {
        "id": "open-registration",
        "action": "goto",
        "path": "/openmrs/spa/patient-registration"
      },
      {
        "id": "given-name",
        "action": "fill",
        "target": {
          "frames": [],
          "locator": {
            "by": "css",
            "selector": "#givenName"
          }
        },
        "value": {
          "source": "literal",
          "value": "Taro"
        }
      },
      {
        "id": "family-name",
        "action": "fill",
        "target": {
          "frames": [],
          "locator": {
            "by": "css",
            "selector": "#familyName"
          }
        },
        "value": {
          "source": "literal",
          "value": "{{test_value}}"
        }
      },
      {
        "id": "sex",
        "action": "click",
        "target": {
          "frames": [],
          "locator": {
            "by": "css",
            "selector": "label[for=gender-option-male]"
          }
        }
      },
      {
        "id": "birthdate-unknown",
        "action": "click",
        "target": {
          "frames": [],
          "locator": {
            "by": "css",
            "selector": "text=Date of Birth Known? >> xpath=following::button[normalize-space()=\"No\"][1]"
          }
        }
      },
      {
        "id": "estimated-age",
        "action": "fill",
        "target": {
          "frames": [],
          "locator": {
            "by": "css",
            "selector": "#yearsEstimated"
          }
        },
        "value": {
          "source": "literal",
          "value": "40"
        }
      },
      {
        "id": "register",
        "action": "click",
        "target": {
          "frames": [],
          "locator": {
            "by": "css",
            "selector": "button[type=submit]:has-text(\"Register patient\")"
          }
        },
        "wait_response": "patient-save"
      },
      {
        "id": "patient-banner",
        "action": "read_text",
        "target": {
          "frames": [],
          "locator": {
            "by": "css",
            "selector": "header[aria-label=\"patient banner\"]"
          }
        },
        "contains": "{{test_value}}"
      }
