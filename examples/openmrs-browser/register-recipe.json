        "role": "database",
        "expose": 3306,
        "env": {
          "MYSQL_DATABASE": "openmrs",
          "MYSQL_USER": "openmrs",
          "MYSQL_PASSWORD": "openmrs",
          "MYSQL_ROOT_PASSWORD": "openmrs"
        },
        "volumes": [
          {
            "name": "db",
            "path": "/var/lib/mysql"
          }
        ],
        "command": [
          "mariadbd",
          "--character-set-server=utf8mb4",
          "--collation-server=utf8mb4_general_ci"
        ],
        "ready": {
          "exec": {
            "args": [
              "/usr/local/bin/healthcheck.sh",
              "--su-mysql",
              "--connect",
              "--innodb_initialized"
