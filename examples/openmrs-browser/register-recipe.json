    "responses": [
      {
        "id": "patient-save",
        "method": "POST",
        "path": "/openmrs/ws/rest/v1/patient/"
      }
    ],
    "database": [
      {
        "id": "name",
        "service": "db",
        "database": "openmrs",
        "table": "person_name",
        "match_column": "family_name",
        "columns": [
          "given_name",
          "family_name",
          "person_id"
        ]
      }
    ]
