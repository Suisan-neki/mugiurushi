{
  "schema_version": 1,
  "base": "soap-recipe.json",
  "note": "架空の患者と診療記録で試します。Gitの参照版と、実行するイメージのコードが同一であることは未確認です。",
  "entries": [
    {
      "id": "openemr-soap",
      "title": "OpenEMR：SOAPの保存と再表示"
    },
    {
      "id": "openemr-soap-db-stopped",
      "title": "OpenEMR：SOAPの保存直前にDBを停止",
      "fault": "database_stopped",
      "fault_before_step": "save-soap",
      "keep_checks": { "id_prefix": "soap-" }
    },
    {
      "id": "openemr-soap-logs",
      "title": "OpenEMR：SOAPの保存でログに試験値が出ないか",
      "keep_checks": { "ids": ["soap-subjective-row"] },
      "add_checks": [
        {
          "id": "soap-log-app",
          "scope": "OpenEMRのコンテナのログ（標準出力・標準エラー）に試験値が出ない",
          "method": "container_log",
          "target": "openemr",
          "expect": "not_contains",
          "text": "{{test_value}}"
        },
        {
          "id": "soap-log-db",
          "scope": "DBのコンテナのログ（標準出力・標準エラー）に試験値が出ない",
          "method": "container_log",
          "target": "mysql",
          "expect": "not_contains",
          "text": "{{test_value}}"
        }
      ]
    }
  ]
}
