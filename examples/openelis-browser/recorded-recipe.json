        "image": "itechuw/openelis-global-2:3.3.0@sha256:b69b2cb7f75642f6be97896ad368767ac5c6383d718a3189be0580eeb2b5171e",
        "role": "app",
        "expose": 8443,
        "env": {
          "SSL_KEYSTORE_PATH": "/etc/openelis-global/keystore",
          "SSL_KEYSTORE_PASSWORD": "kspass",
          "SSL_TRUSTSTORE_PATH": "/etc/openelis-global/truststore",
          "SSL_TRUSTSTORE_PASSWORD": "tspass",
          "DEFAULT_PW": "adminADMIN!",
          "TZ": "America/New_York",
          "OE_ENCRYPTION_PASSWORD": "kspass",
          "ANALYZER_BRIDGE_PAIRING_CODE": "",
          "ORG_OPENELISGLOBAL_FHIRSTORE_URI": "",
          "ANALYZER_BRIDGE_URL": "",
          "CATALINA_OPTS": " -Ddatasource.url=jdbc:postgresql://db.openelis.org:5432/clinlims -Ddatasource.username=clinlims -Ddatasource.password=clinlims -Doe.ssl.truststorepath=/etc/openelis-global/truststore -Doe.ssl.truststorepassword=tspass -Doe.ssl.keystorepath=/etc/openelis-global/keystore -Doe.ssl.keystorepassword=kspass"
        },
        "volumes": [
          {
            "name": "kts",
            "path": "/etc/openelis-global"
          },
          {
            "name": "lucene",
            "path": "/var/lib/lucene_index"
          }
        ],
        "command": [],
        "ready": {
          "http": {
            "path": "/api/OpenELIS-Global/health",
            "tls": true
          }
        },
        "ready_timeout_ms": 600000,
        "aliases": [
          "oe.openelis.org"
        ],
        "start_after": [
          "certs"
        ],
        "files": [
          {
            "from": "configs/properties/common.properties",
            "to": "/run/secrets/common.properties"
          }
        ]
      },
      {
        "name": "proxy",
        "image": "itechuw/openelis-global-2-proxy:3.3.0@sha256:1cdb0a5aa8529c6ddb88ff5fe634c3ca206c9599deb7a0a4decb8d1d6d33185a",
        "role": "other",
        "expose": 443,
        "env": {
          "OE_NGINX_CERT": "apache-selfsigned.crt",
          "OE_NGINX_KEY": "apache-selfsigned.key",
          "OE_HTTPS_PORT": "443"
        },
        "volumes": [
          {
            "name": "certs",
            "path": "/etc/nginx/certs"
          },
          {
            "name": "keys",
            "path": "/etc/nginx/keys"
          }
        ],
        "command": [
          "/bin/sh",
          "-c",
          "envsubst '$OE_NGINX_CERT $OE_NGINX_KEY $OE_HTTPS_PORT' < /etc/nginx/nginx.conf.template > /etc/nginx/nginx.conf && exec nginx -g 'daemon off;'"
        ],
        "ready": {
          "http": {
            "path": "/",
            "tls": true
          }
        },
        "ready_timeout_ms": 60000,
        "start_after": [
          "certs",
          "frontend",
          "oe"
        ],
        "files": [
          {
            "from": "configs/nginx/nginx.conf",
            "to": "/etc/nginx/nginx.conf.template"
          }
        ]
      }
    ]
